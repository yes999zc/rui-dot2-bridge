+// RefForUplink returns one captured period's hardware reference with the ch8
+// decimation aliases removed, for a controller that cancels echo itself
+// (feature "dot2_hw_ref"). It cancels nothing, so it is valid while
+// aecEnabled=false — which is the point: the device stops running seven
+// speex filters and the controller gets the same clean reference.
+//
+// The output ring it needs is fed by WriteFar on every speaker period,
+// regardless of the cancellation switch. clean() carries its own ring lock and
+// runs on the mic goroutine, the same side Process* calls it from.
+func (c *Canceller) RefForUplink(rawRef []byte) []byte {
+	if rawRef == nil || c.dealias == nil {
+		return rawRef
+	}
+	return c.dealias.clean(rawRef)
+}
+
 // RefSource names the far-end reference in use, for the stats report:
 // "hw" once ch8 has proved itself the playback loopback, "sw" for the tap at
 // the ALSA write, "off" while cancellation is disarmed.
