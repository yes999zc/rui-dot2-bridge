# Credentials and device material — never commit.
secrets/
*.pem
*.key
*.crt

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# Captured protocol traces may contain the device token.
docs/trace/*.raw
docs/trace/*.jsonl

# macOS
.DS_Store

# Dev sandbox runtime (config/env/keywords stay tracked; data and logs do not)
dev/rui/data/
dev/rui/logs/
dev/rui/audio.sock
dev/rui/config.last-good.yaml
dev/rui/p2-trials.jsonl
dev/rui/soak*
.docker/
dev/rui2/
dev/rui/data-2ch/
dev/rui*/config.last-good.yaml
dev/rui*/audio*.sock
dev/rui*/logs/
